# Cloudflare Pages デプロイ設定
# このファイルを .env.deploy にコピーして値を埋めてください
CF_PROJECT_NAME=henohe-nun
# preview = 限定公開URL / production = 本番URL
CF_BRANCH=preview
# CF Pages 向けベースパス（GH Pages は /henohe-Nun/、CF Pages は /）
NUN_BASE=/
# OGP 用サイト URL（省略時は GitHub Pages URL が使われる）
NUN_SITE_URL=https://henohe-nun.pages.dev
